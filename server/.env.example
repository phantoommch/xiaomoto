# 复制为 server/.env 或在仓库根目录使用。不要把真令牌提交到 git。
# 管理接口令牌。用 `openssl rand -hex 32` 生成一个长随机串。
ADMIN_TOKEN=
PROMOTE_MIN_REPORTS=1
PROMOTE_RADIUS_M=200
RATE_PER_HOUR=200
RATE_PER_DAY=1000
# 公网 HTTPS 根地址，不要带路径。安装包和 iOS manifest 用它拼绝对 URL。
# 确认域名后再改。Android 工程里的 COMMUNITY_API_BASE_URL 要和它一致。
PUBLIC_BASE_URL=https://example.invalid

# 邮箱激活码。例如 smtp.example.com:465 SSL（网易 163 等邮箱都可以）。
# SMTP_PASS 是邮箱里开启 SMTP 后的授权码，只写在服务器的 server.env，不要写进仓库。
# 没配 SMTP 时，只有 AUTH_DEV=1 才会把激活码打在服务日志里（公网不要开）。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=you@example.com
SMTP_TLS=ssl
AUTH_DEV=
# App 审核用的固定邮箱和激活码。请求这个邮箱不会发信，也不占频率限制。不要写成对外说明。
REVIEW_EMAIL=
REVIEW_CODE=
# 可选。不填就用 DATA_DIR/legal/terms.md 开头的 version。启动时如果文件不存在，会写入程序里的 1.0 文本。
TERMS_VERSION=

# /privacy、/terms、/support 页面上显示的联系邮箱。不填显示 contact@example.com。
CONTACT_EMAIL=

# 高德 Web 服务 Key。服务器用它给低置信度上报重新定位。不要写进仓库。
AMAP_KEY=
