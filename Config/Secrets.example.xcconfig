// 复制为本目录的 Secrets.xcconfig，不要提交真实 Key。
// 高德控制台里选「Web 服务」，不是 iOS SDK。
// 手机直接请求 restapi.amap.com。如果开了 IP 白名单，要放行手机当前出口 IP。
AMAP_WEB_KEY = YOUR_AMAP_WEB_KEY

// 可选。写了就会覆盖 Shared.xcconfig 里的团队 ID。
// DEVELOPMENT_TEAM = YOUR_APPLE_TEAM_ID

// 可选。写了会盖掉 Shared.xcconfig 的同名变量。没部署时保持注释。
// COMMUNITY_API_BASE_URL =
