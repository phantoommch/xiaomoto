diff -u a/Motocam/Core/AuthRoutes.swift b/Motocam/Core/AuthRoutes.swift
--- a/Motocam/Core/AuthRoutes.swift
+++ b/Motocam/Core/AuthRoutes.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+/// Password-login contract for the Mac signing tree (build 39 and the next archive).
+///
+/// Build 39 posts `v1/auth/login-password` with `termsVersion`. That URL is a
+/// plain-text 404 on `https://api.xiaomoto.cloud`. The live password route is
+/// `v1/hajimi/auth/login` and accepts only `email` and `password`.
+/// `reset-password` and `set-password` are still unregistered; their bodies do
+/// not match the live hajimi reset handler, so they are left unchanged.
+enum AuthRoutes {
+    static let passwordLogin = "v1/hajimi/auth/login"
+    static let rejectedBuild39PasswordLogin = "v1/auth/login-password"
+
+    static func joined(base: String, path: String) -> String? {
+        var trimmed = base.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return nil }
+        while trimmed.hasSuffix("/") {
+            trimmed.removeLast()
+        }
+        return trimmed + "/" + path
+    }
+
+    /// Keys the password login body may contain. `termsVersion` is enforced in
+    /// the UI and passed into the session fallback; the live handler rejects it.
+    static func passwordLoginBody(email: String, password: String) -> [String: String] {
+        ["email": email, "password": password]
+    }
+}
diff -u a/MotocamTests/AuthLoginRouteTests.swift b/MotocamTests/AuthLoginRouteTests.swift
--- a/MotocamTests/AuthLoginRouteTests.swift
+++ b/MotocamTests/AuthLoginRouteTests.swift
@@ -0,0 +1,28 @@
+import XCTest
+#if canImport(MotocamCore)
+@testable import MotocamCore
+#else
+@testable import Motocam
+#endif
+
+final class AuthLoginRouteTests: XCTestCase {
+    func testSigningPasswordLoginUsesTheLiveRoute() {
+        XCTAssertEqual(AuthRoutes.passwordLogin, "v1/hajimi/auth/login")
+        XCTAssertNotEqual(AuthRoutes.passwordLogin, AuthRoutes.rejectedBuild39PasswordLogin)
+        XCTAssertEqual(
+            AuthRoutes.joined(base: "https://api.xiaomoto.cloud/", path: AuthRoutes.passwordLogin),
+            "https://api.xiaomoto.cloud/v1/hajimi/auth/login"
+        )
+        XCTAssertEqual(
+            AuthRoutes.joined(base: "https://api.xiaomoto.cloud", path: AuthRoutes.rejectedBuild39PasswordLogin),
+            "https://api.xiaomoto.cloud/v1/auth/login-password"
+        )
+    }
+
+    func testPasswordLoginBodyOmitsTermsVersion() {
+        let body = AuthRoutes.passwordLoginBody(email: "rider@example.com", password: "x")
+        XCTAssertEqual(Set(body.keys), Set(["email", "password"]))
+        XCTAssertNil(body["termsVersion"])
+        XCTAssertNil(body["code"])
+    }
+}
