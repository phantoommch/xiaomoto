# 复制为 server/.env 或在仓库根目录使用。不要把真令牌提交到 git。
# 管理接口令牌。用 `openssl rand -hex 32` 生成一个长随机串。
ADMIN_TOKEN=
PROMOTE_MIN_REPORTS=1
PROMOTE_RADIUS_M=200
RATE_PER_HOUR=200
RATE_PER_DAY=1000
# 公网 HTTPS 根地址，不要带路径。安装包和 iOS manifest 用它拼绝对 URL。
# 确认域名后再改。Android 工程里的 COMMUNITY_API_BASE_URL 要和它一致。
PUBLIC_BASE_URL=https://example.invalid

# 邮箱激活码。例如 smtp.example.com:465 SSL（网易 163 等邮箱都可以）。
# SMTP_PASS 是邮箱里开启 SMTP 后的授权码，只写在服务器的 server.env，不要写进仓库。
# 没配 SMTP 时，只有 AUTH_DEV=1 才会把激活码打在服务日志里（公网不要开）。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=you@example.com
SMTP_TLS=ssl
AUTH_DEV=
# App 审核用的固定邮箱和激活码。请求这个邮箱不会发信，也不占频率限制。不要写成对外说明。
# REVIEW_PASSWORD 可选。不填时，审核账号的密码登录使用 REVIEW_CODE。审核账号不能改密码。
REVIEW_EMAIL=
REVIEW_CODE=
REVIEW_PASSWORD=
# 可选。不填就用 DATA_DIR/legal/terms.md 开头的 version。启动时如果文件不存在，会写入程序里的 1.0 文本。
TERMS_VERSION=

# /privacy、/terms、/support 页面上显示的联系邮箱。不填显示 contact@example.com。
CONTACT_EMAIL=

# 高德 Web 服务 Key。服务器用它给低置信度上报重新定位。不要写进仓库。
AMAP_KEY=

# /admin 统计页。生产用已有的 bcrypt 哈希，不要把明文密码写进仓库。
# 未设置 ADMIN_PASSWORD_HASH 和 ADMIN_PASSWORD 时，/admin 返回 404。
# ADMIN_HOST 设成对外域名后，其它 Host 也返回 404。会话 cookie 30 天，只走 /admin。
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_HOST=
# 统计里标成测试账号的邮箱，逗号分隔。不要写进仓库；留空则只按 REVIEW_EMAIL 识别审核账号。
STATS_TEST_EMAILS=
# App Store Connect。四项都空时，管理页的 iPhone 测试版显示「未配置」，不影响启动。
# 缺任何一项同样视为未配置。私钥文件只放在服务器上。
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
ASC_APP_ID=
